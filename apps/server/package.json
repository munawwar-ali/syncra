{
  "name": "@syncra/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@syncra/protocol": "workspace:*",
    "@syncra/shared": "workspace:*",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.10.0",
    "node-pg-migrate": "^7.7.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "prom-client": "^15.1.0",
    "uuid": "^10.0.0",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@syncra/client": "workspace:*",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "16.14.0-beta.17",
    "tsx": "^4.19.0"
  }
}
