# One-shot: run migrations on the control DB and every shard, then seed the demo tenant.
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @syncra/server... build

FROM node:22-bookworm-slim
RUN corepack enable
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=build /repo /repo
# Runs as root so it can write the credentials file into the bind-mounted ./.syncra directory.
CMD ["node", "apps/server/dist/db/migrate-cli.js"]
