# Sync node. Build context is the repo root: docker build -f infra/docker/Dockerfile.server .
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @syncra/server... build

FROM node:22-bookworm-slim
RUN corepack enable
WORKDIR /repo
ENV NODE_ENV=production
# The whole built workspace is copied: workspace packages resolve through node_modules symlinks.
# shortcut: the image carries dev dependencies too; slim it with `pnpm deploy --prod` once the
# workspace enables inject-workspace-packages.
COPY --from=build /repo /repo
USER node
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD node -e "fetch('http://127.0.0.1:8080/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/server/dist/main.js"]
