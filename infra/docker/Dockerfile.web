# Edge image: Nginx plus the built dashboard (/), notes demo (/notes/) and inspection demo (/inspection/). Build context is the repo root.
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile \
 && pnpm --filter @syncra/dashboard... build \
 && pnpm --filter @syncra/demo-notes... build \
 && pnpm --filter @syncra/demo-notes exec vite build --base=/notes/ --outDir dist-notes \
 && pnpm --filter @syncra/demo-inspection exec vite build --base=/inspection/ --outDir dist-inspection

FROM nginx:1.27-alpine
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /repo/apps/dashboard/dist /usr/share/nginx/html/dashboard
COPY --from=build /repo/apps/demo-notes/dist-notes /usr/share/nginx/html/demo-notes
COPY --from=build /repo/apps/demo-inspection/dist-inspection /usr/share/nginx/html/demo-inspection
