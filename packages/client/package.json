{
  "name": "@syncra/client",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/mark-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@syncra/protocol": "workspace:*",
    "@syncra/shared": "workspace:*",
    "idb": "^8.0.4",
    "lib0": "^0.2.99",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@syncra/testkit": "workspace:*",
    "@types/node": "^22.7.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^3.22.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munawwar-ali/syncra.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fakes.*"
  ],
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  }
}
