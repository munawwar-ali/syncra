{
  "name": "@syncra/react",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/mark-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@syncra/client": "workspace:*"
  },
  "devDependencies": {
    "@syncra/testkit": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "yjs": "^13"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munawwar-ali/syncra.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fakes.*"
  ],
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  }
}
