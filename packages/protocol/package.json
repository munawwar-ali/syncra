{
  "name": "@syncra/protocol",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/mark-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "lib0": "^0.2.99"
  },
  "devDependencies": {
    "fast-check": "^3.23.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munawwar-ali/syncra.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fakes.*"
  ],
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  }
}
