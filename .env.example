# Copy to .env. Every variable is documented in docs/spec/03 section 9.
NODE_ENV=development
PORT=8080
# NODE_ID defaults to the hostname
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173

CONTROL_DATABASE_URL=postgres://syncra:syncra_dev_password@localhost:5432/syncra_control
SHARD_DATABASE_URLS=postgres://syncra:syncra_dev_password@localhost:5433/syncra_shard_0,postgres://syncra:syncra_dev_password@localhost:5434/syncra_shard_1
REDIS_URL=redis://localhost:6379

# Generate real values: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
METRICS_TOKEN=
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

BILLING_ENABLED=false
DEFAULT_PLAN=selfhost
BATCH_WINDOW_MS=20
BATCH_MAX_BYTES=262144
SNAPSHOT_EVERY_OPS=500
SNAPSHOT_EVERY_BYTES=1048576
SNAPSHOT_IDLE_MS=60000
CHECKPOINT_INTERVAL_MS=300000
HOT_DOC_CACHE_MAX=500
HOT_DOC_IDLE_MS=60000
MAX_UPDATE_BYTES=1048576
MAX_MESSAGE_BYTES=2097152
WS_OUTBOUND_HIGH_WATER=1048576
WS_SLOW_CLOSE_MS=15000
RL_CONN_RATE=100
RL_CONN_BURST=200
RL_IP_RATE=20
RL_AUTH_PER_MIN=5
WEBHOOK_ALLOW_PRIVATE=false
SEED_DEMO_TENANT=true
